@model IEnumerable<QuanLyQuanCafeWeb.Models.TaiKhoan>
@{
    ViewData["Title"] = "Quản lý tài khoản";
}
<div class="container mt-4">
    <h2 class="mb-3">Quản lý tài khoản</h2>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    <a asp-action="Create" class="btn btn-primary mb-3">Thêm tài khoản</a>
    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tìm tên đăng nhập hoặc họ tên..." />
        </div>
        <div class="col-md-4">
            <select name="vaiTro" class="form-select" asp-items="ViewBag.VaiTroList">
                <option value="">Tất cả vai trò</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
        </div>
    </form>
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr><th>Mã tài khoản</th><th>Tên đăng nhập</th><th>Họ tên</th><th>Vai trò</th><th>Điểm tích lũy</th><th>Trạng thái</th><th>Thao tác</th></tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var tk in Model)
                {
                    <tr><td>@tk.MaTk</td><td>@tk.TenDangNhap</td><td>@tk.HoTen</td><td>@tk.VaiTro</td><td>@tk.DiemTichLuy</td><td>@(tk.TrangThai ? "Hoạt động" : "Đã khóa")</td>
                        <td><a asp-action="Edit" asp-route-id="@tk.MaTk" class="btn btn-warning btn-sm">Sửa</a> <a asp-action="Delete" asp-route-id="@tk.MaTk" class="btn btn-danger btn-sm">Xóa</a></td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center">Không tìm thấy tài khoản nào.</td></tr>
            }
        </tbody>
    </table>
</div>
