@model QuanLyQuanCafeWeb.Models.TaiKhoan
@{
    ViewData["Title"] = "Xóa tài khoản";
}
<div class="container mt-4">
    <h2 class="mb-3">Xác nhận xóa tài khoản</h2>
    <div class="alert alert-warning">Bạn có chắc muốn xóa tài khoản này không? Tài khoản đã liên kết với Order sẽ không được phép xóa.</div>
    <p><strong>Tên đăng nhập:</strong> @Model.TenDangNhap</p>
    <p><strong>Họ tên:</strong> @Model.HoTen</p>
    <p><strong>Vai trò:</strong> @Model.VaiTro</p>
    <p><strong>Trạng thái:</strong> @(Model.TrangThai ? "Hoạt động" : "Đã khóa")</p>
    <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn chắc chắn muốn xóa tài khoản này?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.MaTk" />
        <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>